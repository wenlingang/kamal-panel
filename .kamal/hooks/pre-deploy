#!/bin/sh
# .kamal/hooks/pre-deploy
#
# Report to kamal-panel that "this version has started deploying". This script is the same thing as
# the snippet the panel generates for you in the "Deploy reporting" block of the app detail page;
# that snippet has the URL and token embedded directly, while this one reads them from env vars so
# it can be checked into the repo.
#
# Usage: export these two variables on the deploy machine (the token is generated on the panel page
# and shown only once):
#   export PANEL_URL=https://panel.example.com
#   export PANEL_TOKEN=<token generated by the panel>
#
# If unset, skip quietly: a repo that isn't connected to the panel yet shouldn't send requests to
# example.com on every deploy.
[ -n "$PANEL_URL" ] && [ -n "$PANEL_TOKEN" ] || exit 0

# Both --max-time 5 and the trailing || true are mandatory: a down or slow panel must never make
# your deploy fail or hang. Think through the cost before changing either.
curl -sf --max-time 5 -X POST "$PANEL_URL/api/deploys" \
  -H "Authorization: Bearer $PANEL_TOKEN" \
  -d phase=started \
  -d service="$KAMAL_SERVICE" -d destination="$KAMAL_DESTINATION" \
  -d version="$KAMAL_VERSION" -d performer="$KAMAL_PERFORMER" \
  -d recorded_at="$KAMAL_RECORDED_AT" -d command="$KAMAL_COMMAND" || true
