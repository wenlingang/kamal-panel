# This file is checked into git, so **never put plaintext credentials here**: it only documents "where each variable comes from".
# Every line below is a ready-to-run default: read from the current shell's environment variables.
# Better: switch to a password manager; Kamal has built-in adapters, for example:
#
#   SECRETS=$(kamal secrets fetch --adapter 1password --account your-account \
#             --from Vault/kamal-panel RAILS_MASTER_KEY AR_ENCRYPTION_PRIMARY_KEY)
#   RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Credentials for ghcr.io. The username is your GitHub username or org name; for the password use a
# PAT with write:packages permission, not your account password.
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails master key. config/master.key itself must never go into git.
RAILS_MASTER_KEY=$(cat config/master.key)

# The three keys for Active Record encryption, used to encrypt the stored SSH private keys.
# Generate: bin/rails db:encryption:init (it prints the three values).
#
# ⚠️ Once these three values are lost, the SSH private keys already encrypted in the database become [permanently undecryptable]; the panel will
#    report decryption failures on every collection run, and the only way out is to re-enter every app's private key.
#    Back them up in the same place as master.key.
AR_ENCRYPTION_PRIMARY_KEY=$AR_ENCRYPTION_PRIMARY_KEY
AR_ENCRYPTION_DETERMINISTIC_KEY=$AR_ENCRYPTION_DETERMINISTIC_KEY
AR_ENCRYPTION_KEY_DERIVATION_SALT=$AR_ENCRYPTION_KEY_DERIVATION_SALT
