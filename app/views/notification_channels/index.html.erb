<div class="page-head">
  <div class="page-title">
    <h1><%= t(".title") %></h1>
    <p class="page-sub"><%= t(".subtitle") %></p>
  </div>
  <div class="head-actions">
    <%= link_to t(".add"), new_notification_channel_path, class: "btn" %>
  </div>
</div>

<section class="section">
  <div class="panel panel-flush">
    <%= render "notification_channels/table", channels: @channels, manage: true %>
  </div>
  <% if PanelUrl.base.nil? %>
    <p class="hint"><%= t(".no_panel_url") %></p>
  <% end %>
</section>
