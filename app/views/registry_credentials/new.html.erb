<div class="page-head">
  <div class="page-title">
    <h1><%= t(".title") %></h1>
    <p class="page-sub"><%= t(".subtitle") %></p>
  </div>
</div>

<section class="section">
  <div class="panel">
    <%= form_with model: @credential do |form| %>
      <% if @credential.errors.any? %>
        <ul class="errors">
          <% @credential.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>

      <div>
        <%= form.label :name, t(".name") %>
        <%= form.text_field :name, autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :value, t(".value") %>
        <%= form.password_field :value, autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :server, t(".server") %>
        <%= form.text_field :server, autocomplete: "off" %>
        <p class="hint"><%= t(".server_hint") %></p>
      </div>

      <%= form.submit t("common.save"), class: "btn-primary" %>
    <% end %>
  </div>
</section>
