<div class="page-head">
  <div class="page-title">
    <h1><%= t(".title") %></h1>
    <p class="page-sub"><%= t(".subtitle") %></p>
  </div>
</div>

<section class="section">
  <div class="section-head">
    <h2><%= t(".ssh_keys") %></h2>
    <%= link_to t(".add_ssh_key"), new_credential_path, class: "btn-primary" %>
  </div>
  <div class="panel">
    <% if @credentials.empty? %>
      <p class="empty-hint"><%= t(".no_ssh_keys") %></p>
    <% else %>
      <table>
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th><%= t(".fingerprint") %></th>
            <th><%= t(".used_by") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @credentials.each do |credential| %>
            <tr>
              <td><%= credential.name %></td>
              <td class="mono"><%= credential.fingerprint %></td>
              <td><%= app_name_list(credential.managed_apps, empty: t(".unused")) %></td>
              <td>
                <%# Wrap it: button_to generates a block-level <form>, and putting it directly in the cell would
                    drop onto the line below "Replace" on its own. %>
                <div class="row-actions">
                  <%= link_to t("common.replace"), edit_credential_path(credential), class: "btn-quiet" %>
                  <%# The delete entry is not shown while it is referenced. The controller side still blocks it — hiding it in the view
                      only saves a click that is bound to fail; it is not the authorization itself. %>
                  <% if credential.managed_apps.empty? %>
                    <%= button_to t(".delete"), credential_path(credential),
                                  method: :delete, class: "btn-quiet" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <h2><%= t(".registry_passwords") %></h2>
    <%= link_to t(".add_registry_password"), new_registry_credential_path, class: "btn-primary" %>
  </div>
  <div class="panel">
    <% if @registry_credentials.empty? %>
      <p class="empty-hint"><%= t(".no_registry_passwords") %></p>
    <% else %>
      <table>
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th><%= t(".registry") %></th>
            <th><%= t(".used_by") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @registry_credentials.each do |credential| %>
            <tr>
              <td><%= credential.name %></td>
              <td><%= credential.server.presence || "—" %></td>
              <td><%= app_name_list(credential.managed_apps, empty: t(".unused")) %></td>
              <td>
                <div class="row-actions">
                  <%= link_to t("common.replace"), edit_registry_credential_path(credential), class: "btn-quiet" %>
                  <% if credential.managed_apps.empty? %>
                    <%= button_to t(".delete"), registry_credential_path(credential),
                                  method: :delete, class: "btn-quiet" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</section>
