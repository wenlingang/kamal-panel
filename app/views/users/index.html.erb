<div class="page-head">
  <div class="page-title">
    <h1><%= t(".title") %></h1>
    <p class="page-sub"><%= t(".subtitle") %></p>
  </div>
  <%= link_to t(".add"), new_user_path, class: "btn-primary" %>
</div>

<section class="section">
  <div class="panel">
    <table>
      <thead>
        <tr>
          <th><%= t(".nickname") %></th>
          <th><%= t(".email") %></th>
          <th><%= t(".role") %></th>
          <th><%= t(".apps") %></th>
          <th><%= t(".status") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.nickname.presence || "—" %></td>
            <td><%= user.email_address %></td>
            <td><%= t("roles.#{user.role}") %></td>
            <td>
              <%# admin and ops get their permissions from the site-wide role, not the membership table — say so honestly here,
                  so nobody thinks adding members for an admin is the complete configuration. %>
              <% if user.developer? %>
                <%= app_name_list(user.managed_apps, empty: placeholder(t(".no_apps"))) %>
              <% else %>
                <%= t(".site_wide") %>
              <% end %>
            </td>
            <td><%= user.deactivated? ? t(".deactivated") : t(".active") %></td>
            <td>
              <div class="row-actions">
                <%= link_to t("common.edit"), edit_user_path(user), class: "btn-quiet" %>
                <% if user == Current.user %>
                  <span class="muted"><%= t(".you") %></span>
                <% elsif user.deactivated? %>
                  <%= button_to t(".reactivate"), reactivate_user_path(user),
                                method: :post, class: "btn-quiet" %>
                <% else %>
                  <%= button_to t(".deactivate"), deactivate_user_path(user),
                                method: :post, class: "btn-quiet btn-danger" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
