<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Kamal Panel" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kamal Panel">
    <meta name="mobile-web-app-capable" content="yes">
    <%# After collection finishes, the refresh broadcast by PollManagedAppJob makes the browser re-request the current
        page. morph merges the new DOM into the old DOM rather than replacing the whole page: scroll position and
        input focus are both kept — if the overview page's search box is refreshed while someone is typing, no characters are lost. %>
    <meta name="turbo-refresh-method" content="morph">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# This layout has two shells. Signed in: a fixed dark sidebar plus the content column. Signed out
        (login, forgot password, set a new password): a standalone centered card with no navigation — there
        is no "current user" yet and nowhere to navigate to. %>
    <% if authenticated? %>
      <%# Below 900px the sidebar becomes a drawer opened from a top bar. The drawer behaviour is switched on
          by nav-drawer itself (it adds .has-drawer): without JS the sidebar simply stacks above the content
          and every link stays reachable. %>
      <div class="shell" data-controller="nav-drawer"
           data-action="keydown.esc@window->nav-drawer#close">
        <header class="topbar">
          <%= link_to root_path, class: "topbar-brand" do %>
            <%= render "shared/mark", size: "1.25rem" %>Kamal Panel
          <% end %>
          <button type="button" class="menu-button" aria-controls="sidebar" aria-expanded="false"
                  data-nav-drawer-target="button" data-action="nav-drawer#toggle">
            <%= icon_tag("menu") %><span><%= t(".menu") %></span>
          </button>
        </header>

        <aside id="sidebar" class="sidebar" data-nav-drawer-target="panel">
          <%= link_to root_path, class: "sidebar-brand" do %>
            <%= render "shared/mark", size: "1.5rem" %>Kamal Panel
          <% end %>

          <%# Entries live in NavigationHelper: one line per section, so later sections slot in
              without touching this markup. %>
          <nav class="side-nav" aria-label="<%= t(".main_nav") %>">
            <ul>
              <% primary_nav_items.each do |item| %>
                <li><%= sidebar_link(item) %></li>
              <% end %>
            </ul>

            <% if (settings = settings_nav_items).any? %>
              <p class="side-nav-label" id="side-nav-settings"><%= t(".settings") %></p>
              <ul aria-labelledby="side-nav-settings">
                <% settings.each do |item| %>
                  <li><%= sidebar_link(item) %></li>
                <% end %>
              </ul>
            <% end %>
          </nav>

          <%# The account menu: who is signed in, their language, signing out. Language is a personal
              preference, so it lives with the account rather than as a bare select next to "sign out" (where
              a lone "中" read as a stray control). <details> opens and closes without JS; the dismiss
              controller only adds closing on an outside click or Esc. %>
          <div class="sidebar-user">
            <details class="account-menu" data-controller="dismiss"
                     data-action="click@window->dismiss#outside keydown.esc@window->dismiss#close">
              <summary class="account-trigger">
                <span class="account-avatar" aria-hidden="true"><%= Current.user&.display_name.to_s.first.upcase %></span>
                <span class="account-text">
                  <span class="account-name"><%= Current.user&.display_name %></span>
                  <span class="account-role"><%= t("roles.#{Current.user&.role}") if Current.user %></span>
                </span>
                <%= icon_tag("chevron-down", size: :sm, css: "account-chevron") %>
              </summary>

              <div class="account-popover">
                <p class="account-email"><%= Current.user&.email_address %></p>

                <%# Only one selectable language would make a one-item choice: render nothing then. %>
                <% if User::SELECTABLE_LOCALES.many? %>
                  <div class="account-section" role="group" aria-labelledby="account-language">
                    <p class="account-label" id="account-language"><%= icon_tag("globe", size: :sm) %><%= t(".language") %></p>
                    <% User::SELECTABLE_LOCALES.each do |locale| %>
                      <% current = locale == I18n.locale.to_s %>
                      <%= button_to locale_path, method: :patch, params: { locale: locale },
                                    class: "account-item", form_class: "account-item-form",
                                    aria: { pressed: current }, lang: locale, data: { locale: locale } do %>
                        <span><%= locale_name(locale) %></span>
                        <%= icon_tag("check", size: :sm, css: "account-check") if current %>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>

                <div class="account-section">
                  <%= button_to session_path, method: :delete, class: "account-item", form_class: "account-item-form" do %>
                    <%= icon_tag("log-out", size: :sm) %><span><%= t(".sign_out") %></span>
                  <% end %>
                </div>
              </div>
            </details>
          </div>
        </aside>

        <div class="drawer-scrim" data-nav-drawer-target="scrim" data-action="click->nav-drawer#close" hidden></div>

        <main class="page">
          <%# Only render the [message] keys. flash is also used to carry payloads across one redirect (:hook_token
              is the plaintext report token, read by deploy_reporting and rendered into a script); rendering that as a message
              would put a secret naked at the top of the page. %>
          <% flash.to_h.slice("notice", "alert", "warning").each do |type, message| %>
            <p class="flash flash-<%= type %>" role="<%= type.to_s == "notice" ? "status" : "alert" %>">
              <%= icon_tag(flash_icon(type), size: :sm) %><%= message %>
            </p>
          <% end %>

          <%= yield %>
        </main>
      </div>
    <% else %>
      <%# No flash here: the three signed-out pages each render flash [inside] their card. Rendering it here too
          would put it above the centered card, full width and out of line with it — and before, both sides
          rendered it, so on a failed login the same sentence appeared twice. %>
      <main class="page page-auth">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
