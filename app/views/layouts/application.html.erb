<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kamal Panel" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kamal Panel">
    <meta name="mobile-web-app-capable" content="yes">
    <%# After collection finishes, the refresh broadcast by PollManagedAppJob makes the browser re-request the current
        page. morph merges the new DOM into the old DOM rather than replacing the whole page: scroll position and
        input focus are both kept — if the overview page's search box is refreshed while someone is typing, no characters are lost. %>
    <meta name="turbo-refresh-method" content="morph">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# The auth pages are a standalone centered card and want no header — at that point there is no "current user" to speak of,
        and nowhere to navigate to either. %>
    <% if authenticated? %>
      <header class="chrome">
        <nav class="chrome-nav">
          <%= link_to root_path, class: "chrome-brand" do %>
            <%= render "shared/mark", size: "20px" %>Kamal Panel
          <% end %>
          <%= nav_link_to t(".overview"), root_path, controllers: "overviews", icon: "layout-grid" %>
          <%# The "Apps" tab also contains actions (the output page of a given action); they are all
              pages under /apps/..., so the highlight should stay on "Apps". %>
          <%= nav_link_to t(".apps"), managed_apps_path, controllers: %w[managed_apps actions], icon: "box" %>
          <%= nav_link_to t(".audit"), audit_logs_path, controllers: "audit_logs", icon: "scroll-text" %>
          <%# Only admin sees the people entry — the check uses the same UserPolicy as the controller. %>
          <%= allowed_to(:manage, User) do %>
            <%= nav_link_to t(".people"), users_path, controllers: "users", icon: "users" %>
          <% end %>
          <%= allowed_to(:manage, Credential) do %>
            <%= nav_link_to t(".credentials"), credentials_path,
                            controllers: %w[credentials registry_credentials],
                            icon: "key-round" %>
          <% end %>
        </nav>
        <div class="chrome-user">
          <%# When there is only one selectable language, render nothing at all: giving a dropdown with a single option
              would make people think there are others to choose. %>
          <% if User::SELECTABLE_LOCALES.many? %>
            <span class="chrome-locale">
              <%# The submit button is the [fallback when JS is absent] — the select does not submit the form by itself.
                  With JS, the auto-submit controller hides it, turning it into "pick and go".
                  Hiding it must be done by JS rather than hard-coded in CSS: CSS cannot know
                  whether JS has actually loaded. %>
              <%= form_with url: locale_path, method: :patch, class: "locale-form",
                            data: { controller: "auto-submit",
                                    action: "change->auto-submit#submit" } do |form| %>
                <%= form.label :locale, t(".language"), class: "visually-hidden" %>
                <%= form.select :locale,
                                options_for_select(
                                  User::SELECTABLE_LOCALES.map { |l| [ locale_label(l), l ] },
                                  I18n.locale.to_s
                                ),
                                {}, { name: "locale" } %>
                <%= form.submit t(".switch_language"),
                                class: "btn-quiet",
                                data: { auto_submit_target: "fallback" } %>
              <% end %>
            </span>
          <% end %>
          <span><%= Current.user&.display_name %></span>
          <%= button_to t(".sign_out"), session_path, method: :delete, class: "btn-quiet" %>
        </div>
      </header>
    <% end %>

    <main class="page">
      <%# flash follows the header, with a condition exactly the same as the header above — this layout actually has
          two shells: after login it is "header + wide container", before login it is the auth page's own centered card.
          The .flash styles are meant for the wide container; stuck above a centered card they would span the full width, left-aligned,
          and not line up with the card. The three logged-out pages (login, forgot password, set new password) each render flash
          [inside] their card, so it must not be rendered again here — before, both sides rendered it, so on a failed
          login the same sentence appeared twice. %>
      <%# Only render the [message] keys. flash is also used to carry payloads across one redirect (:hook_token
          is the plaintext report token, read by deploy_reporting and rendered into a script); rendering that as a message
          would put a secret naked at the top of the page. %>
      <% if authenticated? %>
        <% flash.to_h.slice("notice", "alert", "warning").each do |type, message| %>
          <p class="flash flash-<%= type %>" role="<%= type.to_s == "notice" ? "status" : "alert" %>">
            <%= icon_tag(flash_icon(type), size: :sm) %><%= message %>
          </p>
        <% end %>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
