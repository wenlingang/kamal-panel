<%# When the two data sources contradict, put the contradiction on the table rather than picking one to trust (main design 6.4). %>
<% alerts = DeployAlerts.new(managed_app).list %>
<% if alerts.any? %>
  <div class="deploy-alerts" role="alert">
    <% alerts.each do |alert| %>
      <p class="deploy-alert deploy-alert-<%= alert[:kind] %>">
        <strong><%= alert[:kind] == :unobserved ? t(".unobserved") : t(".unfinished") %></strong>
        —— <%= alert[:message] %>
      </p>
    <% end %>
  </div>
<% end %>
