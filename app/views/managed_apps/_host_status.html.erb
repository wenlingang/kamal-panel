<%# This block is replaced as a whole by PollManagedAppJob after every collection round (target id: host-status),
    so it must be self-contained: everything it needs is passed in via locals, and it does not read @ variables. %>
<div id="host-status">
  <p class="data-age">
    <% if status.observed_at %>
      <%# What is taken is "the oldest one among each machine in the config", not "the most recent successful collection" —
          the only honest statement is "no data here is older than this" (see Task 11 review). %>
      <%= t(".oldest_from", time: time_ago_in_words(status.observed_at)) %>
      <%= t(".stale_suffix") if status.stale? %>
    <% elsif status.level == :unknown %>
      <%= t(".never_collected") %>
    <% else %>
      <%# Some machine in the config has no observation at all — in that case do not give a number that looks precise but
          does not hold (see Task 11 review, round three). %>
      <%= t(".partially_collected") %>
    <% end %>
  </p>

  <%= render "managed_apps/host_table", status: status %>
</div>
