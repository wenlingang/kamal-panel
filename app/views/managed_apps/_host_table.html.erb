<table class="host-table">
  <thead>
    <tr>
      <th><%= t(".host") %></th>
      <th><%= t(".role") %></th>
      <th><%= t(".version") %></th>
      <th><%= t(".docker_status") %></th>
      <%# A container running != receiving traffic; the two columns must be kept separate (spec 8.2) %>
      <th><%= t(".routed") %></th>
      <th><%= t(".collection") %></th>
    </tr>
  </thead>
  <tbody>
    <% status.last_known_rows.each do |row| %>
      <tr class="<%= "row-unreachable" if row[:reachable] == false %>">
        <td><%= row[:host] %></td>
        <td><%= row[:role] || "—" %></td>
        <td><%= row[:version] || "—" %></td>
        <td>
          <%= row[:docker_status] || "—" %>
          <%= t(".health_suffix", health: row[:health]) if row[:health].present? %>
        </td>
        <td>
          <%# Receiving traffic is tri-state: nil is "the panel does not know" and must not be rendered as a definite "no"
              (see final review I2). %>
          <% if row[:routed].nil? %>
            <%= t(".unknown") %>
          <% else %>
            <%= row[:routed] ? t(".yes") : t(".no") %>
          <% end %>
        </td>
        <td>
          <% if row[:reachable] %>
            <%= t(".ok") %>
            <%# A quiet data-age hint — not an alarm, just information (see Task 11 review):
                the collection time of each machine within one app may differ in freshness, and the single "data age" number at the top of
                the overview/detail page takes the oldest machine; that one number alone
                cannot tell "this machine is old" from "all machines are this old", so it is added row by row here,
                using <small> to stay visually quiet and not steal attention from the normal state. %>
            <% if row[:observed_at] %>
              <br><small><%= t(".collected_ago", time: time_ago_in_words(row[:observed_at])) %></small>
            <% end %>
          <% elsif row[:reachable].nil? %>
            <%# The machine is in the config but has never been asked — we cannot say "unreachable", which would imply
                "was once contacted and is now cut off", when the panel never even tried (see Task 11). %>
            <%= t(".never_collected") %>
          <% elsif row[:unparseable_output] %>
            <%# SSH to the host works, only the docker ps output cannot be understood — this is not "the machine is gone"
                and must not share a set of copy with true unreachability. This check used to match here with include? against the
                Chinese sentence the collector produces, which stored the same five characters in two places; now ManagedAppStatus
                decides it in one place (see Collectors::ContainerCollector::UNPARSEABLE_OUTPUT_MARKER). %>
            <strong><%= t(".unparseable") %></strong>
            <br><small><%= t(".unparseable_detail") %></small>
          <% else %>
            <strong><%= t(".unreachable") %></strong>
            <% if row[:stale_since] %>
              — <%= t(".stale_since", time: time_ago_in_words(row[:stale_since])) %>
            <% else %>
              <%# The fallback finds nowhere to land: this machine has never had a reachable observation, so "keep
                  the last known state" has no "last" to keep. Better to say it honestly than to
                  leave a blank row that looks like nothing was written (see Task 11 review). %>
              — <%= t(".no_history") %>
            <% end %>
            <% if row[:error].present? %>
              <br><small><%= row[:error] %></small>
            <% end %>
          <% end %>
        </td>
      </tr>
      <% unless row[:configured] %>
        <tr class="row-decommissioned">
          <td colspan="6">
            <small>
              <%# deploy.yml is the single source of truth: this machine is no longer in the current config
                  and is no longer part of this app — do not delete this row (deleting it would quietly discard
                  the information that "it once existed"), but it must never be left showing "normal" without
                  any qualifier (see Task 11 review). %>
              <%= t(".decommissioned", host: row[:host]) %>
            </small>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
