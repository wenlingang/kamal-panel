<% broken = @managed_app.last_poll_error.present? %>
<%# The header must still render when the config cannot be parsed: nothing here touches parsed_config for a
    broken app (see the comment on the parse-error branch of the overview tab). %>
<% status = ManagedAppStatus.new(@managed_app) unless broken %>

<%= breadcrumb(t(".back"), root_path) %>

<div class="page-head app-head">
  <div class="page-title">
    <h1>
      <%= @managed_app.name %>
      <%= render "managed_apps/status_badge", managed_app: @managed_app, status: status %>
    </h1>
    <dl class="head-facts">
      <div>
        <dt><%= t(".running_version") %></dt>
        <dd>
          <% if status.nil? || status.versions.empty? %>
            <%= placeholder("—") %>
          <% else %>
            <%= version_links(@managed_app, status.versions) %>
            <% if status.drift? %>
              <strong class="suffix"><%= t("overviews.grid.version_drift", count: status.versions.size) %></strong>
            <% end %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt><%= t(".destination") %></dt>
        <dd><%= @managed_app.destination.presence || placeholder(t(".destination_none")) %></dd>
      </div>
      <% unless broken %>
        <div>
          <dt><%= t(".host_count") %></dt>
          <dd><%= @managed_app.cached_app_hosts.size %></dd>
        </div>
      <% end %>
    </dl>
  </div>
  <%# Primary actions slot: deploying comes first. %>
  <div class="head-actions">
    <% if !broken && policy_for(@managed_app).act? %>
      <%= link_to managed_app_path(@managed_app, tab: "deploy"), class: "btn-primary" do %>
        <%= icon_tag("rocket", size: :sm) %><span><%= t(".deploy_new") %></span>
      <% end %>
    <% end %>
    <%# Restart from the header without opening the actions tab. Skipped for an unparseable config: the
        actions tab says why nothing can run then. %>
    <% unless broken %>
      <%= render "managed_apps/quick_actions", managed_app: @managed_app,
                 show_actions_link: @tab != "actions", logs_link: (managed_app_path(@managed_app, tab: "logs") unless @tab == "logs") %>
    <% end %>
    <%= allowed_to(:act, @managed_app) do %>
      <%= link_to edit_managed_app_path(@managed_app), class: "btn" do %>
        <%= icon_tag("pencil", size: :sm) %><span><%= t(".edit") %></span>
      <% end %>
    <% end %>
    <%= allowed_to(:deactivate, @managed_app) do %>
      <% if @managed_app.deactivated? %>
        <%= button_to t(".reactivate"), reactivate_managed_app_path(@managed_app), method: :post,
                      form: { data: { turbo_confirm: t(".reactivate_confirm", name: @managed_app.name) } } %>
      <% else %>
        <%= button_to t(".deactivate"), deactivate_managed_app_path(@managed_app), method: :post, class: "btn-danger",
                      form: { data: { turbo_confirm: t(".deactivate_confirm", name: @managed_app.name),
                                      confirm_danger: true } } %>
      <% end %>
    <% end %>
  </div>
  <div class="head-pulse">
    <%# Replaced by PollManagedAppJob after each round (target id: app-heartbeat). %>
    <%= render "shared/heartbeat", history: StatusHistory.new(@managed_app), id: "app-heartbeat",
                                     problems_url: managed_app_path(@managed_app, anchor: "problem-rounds") %>
  </div>
</div>

<%# Replaced by the PollManagedAppJob broadcast after collection finishes: #app-status, #app-heartbeat and,
    on the overview tab, #host-status. Subscribed on every tab so the header stays live. %>
<%= turbo_stream_from "managed_app_#{@managed_app.id}" %>

<% if @managed_app.deactivated? %>
  <%# After deactivation this page can still be opened — if it could not be seen there would be no way to re-enable it — but it must say clearly what state it is in now. %>
  <p class="callout callout-warn">
    <%= t(".deactivated_html",
          link: link_to(t(".deactivated_link"), edit_managed_app_path(@managed_app))).html_safe %>
  </p>
<% end %>

<% if broken %>
  <%# A config parse failure must speak loudly in the UI, not just leave one log line — otherwise polling would
      stall silently and permanently, and the operator would only see the data getting older without knowing why
      (see final review I4). It sits above the tabs so no tab can hide it. %>
  <div class="config-parse-error-banner" role="alert">
    <strong><%= t(".parse_error_title") %></strong>
    <p><%= t(".parse_error_body", since: time_ago_in_words(@managed_app.first_poll_error_at)) %></p>
    <pre><code><%= @managed_app.last_poll_error %></code></pre>
  </div>
<% end %>

<%= render "managed_apps/firing_alerts", managed_app: @managed_app %>
<%= render "managed_apps/deploy_alerts", managed_app: @managed_app %>

<%# Server-rendered tabs: plain links with ?tab=, so every tab has an address and works without JS.
    Logs is left out for people who may not read this app's logs. %>
<nav class="tabs" aria-label="<%= t(".tabs_label") %>">
  <% visible_tabs.each do |tab| %>
    <%= link_to t(".tabs.#{tab}"), managed_app_path(@managed_app, tab: (tab unless tab == "overview")),
                class: "tab", "aria-current": ("page" if @tab == tab) %>
  <% end %>
</nav>

<div class="tab-body">
  <%= render "managed_apps/tab_#{@tab}", managed_app: @managed_app, status: status %>
</div>
