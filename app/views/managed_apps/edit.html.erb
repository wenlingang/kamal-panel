<p class="breadcrumb"><%= link_to "← #{@managed_app.name}", @managed_app %></p>

<div class="page-head">
  <div class="page-title">
    <h1><%= t(".title", name: @managed_app.name) %></h1>
    <p class="page-sub"><%= t(".subtitle") %></p>
  </div>
</div>

<%# The warning on the onboarding page holds here too: changing deploy.yml also executes code on the machine the panel runs on. %>
<p class="callout callout-warn"><%= t(".erb_warning_html").html_safe %></p>

<%= render "form", managed_app: @managed_app,
                   submit_label: t("common.save"), new_record: false %>
