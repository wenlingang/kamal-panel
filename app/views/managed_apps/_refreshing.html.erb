<%# Placeholder during collection. Keep the #host-status id, otherwise the broadcast after collection finishes
    finds no replacement target, and the page would stay on "collecting" forever. %>
<div id="host-status">
  <p class="data-age data-age--reading">
    <%= render "shared/mark", size: "16px", reading: true %>
    <%= t(".collecting") %>
  </p>
</div>
