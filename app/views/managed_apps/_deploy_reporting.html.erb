<section class="section">
<div class="section-head">
  <h2><%= t(".title") %></h2>
  <div class="head-actions">
    <%= allowed_to(:regenerate_hook_token, managed_app) do %>
      <% if managed_app.hook_reporting_enabled? %>
        <%= button_to t(".regenerate"), managed_app_hook_token_path(managed_app), method: :post,
                      form: { data: { turbo_confirm: t(".regenerate_confirm", name: managed_app.name),
                                      confirm_danger: true } } %>
      <% else %>
        <%= button_to t(".generate"), managed_app_hook_token_path(managed_app), method: :post,
                      form: { data: { turbo_confirm: t(".generate_confirm", name: managed_app.name) } } %>
      <% end %>
    <% end %>
  </div>
</div>
<div class="panel">

<p class="hint"><%= t(".intro_html").html_safe %></p>

<%# Turbo Stream 把弹窗塞进这个插槽（不刷页面）；没有 JS 时走重定向，
    由 flash 里的 token 在这里直接渲染出来。 %>
<div id="hook_token_dialog">
  <% if (token = flash[:hook_token]) %>
    <%= render "managed_apps/hook_token_dialog", managed_app: managed_app, token: token %>
  <% end %>
</div>

<% if managed_app.last_hook_rejection.present? %>
  <p class="hook-rejection" role="alert">
    <strong><%= t(".rejected") %></strong>
    （<%= t(".rejected_ago", time: time_ago_in_words(managed_app.last_hook_rejection_at)) %>）
    —— <%= managed_app.last_hook_rejection %>
  </p>
<% end %>

</div>
</section>
