<section class="section">
<h2><%= t(".title") %></h2>
<div class="panel panel-flush">

<% events = managed_app.deploy_events.recent_first.includes(:audit_log).limit(50) %>
<% if events.empty? %>
  <%# An empty table explains nothing. 401 (token not recognized) and 429 (rate limited) get no app context
      and are invisible on the panel — so the troubleshooting path is given right here, the one outlet for
      that blind spot (spec 03 §8). %>
  <p class="empty-hint">
    <%= t(".empty") %>
    <% if managed_app.hook_reporting_enabled? %>
      <%= t(".empty_hook_enabled_html").html_safe %>
    <% else %>
      <%= t(".empty_hook_disabled") %>
    <% end %>
  </p>
<% else %>
  <%# Only the most recent 50 are fetched, with no pagination — but silent truncation would make people think this is the entire history,
      so it must be stated outright that this is truncated, not the full set. %>
  <p class="deploy-history-hint"><%= t(".truncated") %></p>
  <table class="deploy-history">
    <thead>
      <tr>
        <th><%= t(".version") %></th>
        <th><%= t(".source") %></th>
        <th><%= t(".performer") %></th>
        <th><%= t(".command") %></th>
        <th><%= t(".started") %></th>
        <th><%= t(".finished") %></th>
        <th><%= t(".observation") %></th>
      </tr>
    </thead>
    <tbody>
      <% events.each do |event| %>
        <tr>
          <td><%= version_link(managed_app, event.version) %></td>
          <td><%= event.source_text %></td>
          <td><%= event.performer.presence || "—" %></td>
          <td>
            <% if event.audit_log && policy_for(managed_app).run?(Actions::Deploy) %>
              <%= link_to event.command, managed_app_action_path(managed_app, event.audit_log) %>
            <% else %>
              <%= event.command.presence || "—" %>
            <% end %>
          </td>
          <td><%= event.started_at ? timestamp(event.started_at) : placeholder(t(".not_received")) %></td>
          <td>
            <% if event.failed? %>
              <%# Only panel deploys can end like this: the panel ran the CLI and saw it fail. %>
              <%= deploy_result_badge(:failure) %> <%= timestamp(event.failed_at) %>
            <% elsif event.succeeded_at %>
              <%= timestamp(event.succeeded_at) %>
            <% elsif event.panel? %>
              <%= deploy_result_badge(:running) %>
            <% else %>
              <%= placeholder(t(".not_received")) %>
            <% end %>
          </td>
          <%# Leave a trace: after an alert is resolved, "was that delayed, or observed early" can still
              be worked out. The logic is in DeployEvent#observation_delay_text
              (normally the hook report is later than the container being seen by polling, and delay is negative). %>
          <td><%= event.observation_delay_text || t(".unverified") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
</div>
</section>
