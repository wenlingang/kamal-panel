<div class="page-head">
  <div class="page-title">
    <h1><%= t(".title") %></h1>
    <p class="page-sub"><%= t(".subtitle") %></p>
  </div>
  <div class="head-actions">
    <%= allowed_to(:create_app, ManagedApp) do %>
      <%= link_to t(".add"), new_managed_app_path, class: "btn-primary" %>
    <% end %>
  </div>
</div>

<%# After each polling round the server sends a signal on "overview" (OverviewSignal), not content: it
    can't render this page for anyone, since filters and allowed actions differ per viewer. live-refresh
    then fetches this page's current URL in the background and morphs only the two regions below —
    no page refresh, and the filter bar between them is never touched. %>
<%= turbo_stream_from OverviewSignal::STREAM %>

<div id="<%= OverviewSignal::TARGET %>" data-controller="live-refresh">

<% if !@any_managed_apps %>
  <section class="section" id="overview-empty" data-live-refresh-target="region">
    <div class="panel">
      <%# The watermark is only for the long-lived empty state of "nothing onboarded yet". The one where filtering yields nothing does not get it —
          that is a temporary state, and putting up an enlarged mark would make it look like "something went wrong". %>
      <div class="empty-state">
        <%= icon_tag("box", css: "empty-icon") %>
        <p class="empty-hint"><%= t(".empty") %></p>
      </div>
    </div>
  </section>
<% else %>
  <div id="overview-summary" data-live-refresh-target="region">
    <%= render "summary", summary: @summary, filter: @filter, view: @view %>
  </div>

  <section class="section">
    <div class="toolbar">
      <%= form_with url: overview_path, method: :get, class: "filter-bar",
                  data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
        <%# The view rides along with the filter, so filtering in the table view stays in the table view. %>
        <%= hidden_field_tag :view, @view unless @view == "cards" %>

        <%= form.label :q, t(".filter_name"), class: "visually-hidden" %>
        <span class="field-with-icon">
          <%= icon_tag("search", size: :sm) %>
          <%= form.search_field :q, value: @filter.q, placeholder: t(".filter_name_placeholder"),
                                autocomplete: "off", class: "filter-search" %>
        </span>

        <%= form.label :status, t(".filter_status"), class: "visually-hidden" %>
        <%= form.select :status,
                        options_for_select(OverviewFilter.options, @filter.status),
                        { include_blank: t(".filter_all_statuses") },
                        class: "filter-status" %>

        <%# Filters apply as soon as they change; the button is the no-JS fallback. %>
        <%= form.submit t(".filter_submit"), class: "btn-quiet", data: { auto_submit_target: "fallback" } %>

        <% if @filter.active? %>
          <%= link_to t(".filter_clear"), overview_path(view: (@view unless @view == "cards")), class: "filter-clear" %>
        <% end %>
      <% end %>

      <nav class="segmented" aria-label="<%= t(".view_label") %>">
        <% { "cards" => "layout-grid", "table" => "list" }.each do |view, icon| %>
          <%= link_to overview_path(@filter.to_params.merge(view: (view unless view == "cards"))),
                      class: "segmented-item", "aria-current": ("page" if @view == view) do %>
            <%= icon_tag(icon, size: :sm) %><span><%= t(".view_#{view}") %></span>
          <% end %>
        <% end %>
      </nav>
    </div>

    <div id="overview-results" data-live-refresh-target="region">
    <% if @managed_apps.empty? %>
      <%# This is a different matter from "no app onboarded yet": in that case we should explain how to onboard, and in this case we should
          explain how to step back and see everything. %>
      <div class="panel">
        <p class="empty-hint">
          <%= t(".no_matches_html", link: link_to(t(".filter_clear"), overview_path)).html_safe %>
        </p>
      </div>
    <% elsif @view == "table" %>
      <div class="panel panel-flush">
        <%= render "grid", managed_apps: @managed_apps, statuses: @statuses %>
      </div>
    <% else %>
      <%= render "cards", managed_apps: @managed_apps, statuses: @statuses,
                 metric_summaries: Metrics::CardSummary.for(@managed_apps) %>
    <% end %>
    </div>
  </section>
<% end %>

<%# Deactivated apps are not in the grid above (it answers "what does production look like right
    now"), but they must stay findable here: hidden, they could never be re-enabled. %>
<%# Always rendered (empty or not) so the set of live regions doesn't change when the first app is deactivated. %>
<div id="overview-deactivated" data-live-refresh-target="region">
<% if @deactivated_apps.any? %>
  <section class="section deactivated-apps">
    <h2><%= t(".deactivated_section") %></h2>
    <div class="panel panel-quiet">
      <p class="hint"><%= t(".deactivated_hint") %></p>
      <ul class="record-list">
        <% @deactivated_apps.each do |app| %>
          <li>
            <%= link_to app, class: "record-row" do %>
              <span><%= app.name %></span>
              <%= status_badge("unknown", t(".deactivated_badge")) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
<% end %>
</div>
</div>
