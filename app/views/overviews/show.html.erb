<div class="page-head">
  <div class="page-title">
    <h1><%= t(".title") %></h1>
    <p class="page-sub"><%= t(".subtitle") %></p>
  </div>
  <%= allowed_to(:create_app, ManagedApp) do %>
    <%= link_to t(".add"), new_managed_app_path, class: "btn-primary" %>
  <% end %>
</div>

<%# What PollManagedAppJob broadcasts after collection finishes is a refresh: each browser comes back with its own
    current URL (that is, its own filter criteria) and re-requests this page. The server does not know who is
    filtering what, so it cannot render the grid on anyone's behalf. %>
<%= turbo_stream_from "overview" %>

<% if !@any_managed_apps %>
  <section class="section">
    <div class="panel">
      <%# The watermark is only for the long-lived empty state of "nothing onboarded yet". The one where filtering yields nothing does not get it —
          that is a temporary state, and putting up an enlarged mark would make it look like "something went wrong". %>
      <div class="empty-state">
        <%= icon_tag("box", css: "empty-icon") %>
        <p class="empty-hint"><%= t(".empty") %></p>
      </div>
    </div>
  </section>
<% else %>
  <section class="section">
    <%= form_with url: overview_path, method: :get, class: "filter-bar" do |form| %>
      <%= form.label :q, t(".filter_name"), class: "visually-hidden" %>
      <span class="field-with-icon">
        <%= icon_tag("search", size: :sm) %>
        <%= form.search_field :q, value: @filter.q, placeholder: t(".filter_name_placeholder"),
                              autocomplete: "off", class: "filter-search" %>
      </span>

      <%= form.label :status, t(".filter_status"), class: "visually-hidden" %>
      <%= form.select :status,
                      options_for_select(OverviewFilter.options, @filter.status),
                      { include_blank: t(".filter_all_statuses") },
                      class: "filter-status" %>

      <%= form.submit t(".filter_submit"), class: "btn-quiet" %>

      <% if @filter.active? %>
        <%= link_to t(".filter_clear"), overview_path, class: "filter-clear" %>
      <% end %>
    <% end %>

    <div class="panel">
      <% if @managed_apps.empty? %>
        <%# This is a different matter from "no app onboarded yet": in that case we should explain how to onboard, and in this case we should
            explain how to step back and see everything. %>
        <p class="empty-hint">
          <%= t(".no_matches_html", link: link_to(t(".filter_clear"), overview_path)).html_safe %>
        </p>
      <% else %>
        <%= render "grid", managed_apps: @managed_apps, statuses: @statuses %>
      <% end %>
    </div>
  </section>
<% end %>
