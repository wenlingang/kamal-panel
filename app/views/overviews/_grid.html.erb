<div id="overview-grid">
<table class="overview-grid">
  <thead>
    <tr>
      <th><%= t(".app") %></th>
      <th><%= t(".status") %></th>
      <th><%= t(".running_version") %></th>
      <th><%= t(".hosts") %></th>
      <th><%= t(".data_age") %></th>
    </tr>
  </thead>
  <tbody>
    <% managed_apps.each do |app| %>
      <% if app.last_poll_error.present? %>
        <%# When the config cannot be parsed, status.observed_at / status.stale? /
            app.cached_app_hosts would all re-trigger parsing and blow up here with
            ParseError again — and this time in the render phase, where no caller (including the whole-page
            broadcast after another app's polling finishes) can catch it (see final review I4, a hole found
            and needing to be plugged together during this fix). So this row does not touch
            parsed_config at all and shows only "config parse failed" itself. %>
        <tr class="status-unreachable">
          <td>
            <%= link_to app.name, app %>
            <% if (badge_text = DeployAlerts.new(app).badge_text) %>
              <span class="badge badge-unverified"><%= badge_text %></span>
            <% end %>
          </td>
          <td>
            <%= status_badge("unreachable", t(".config_broken")) %>
          </td>
          <td colspan="2">
            <%= t(".config_broken_detail", since: time_ago_in_words(app.first_poll_error_at)) %>
          </td>
          <td><%= t(".see_app_page") %></td>
        </tr>
      <% else %>
        <% status = statuses[app] %>
        <tr class="status-<%= status.level %>">
          <td>
            <%= link_to app.name, app %>
            <% if (badge_text = DeployAlerts.new(app).badge_text) %>
              <span class="badge badge-unverified"><%= badge_text %></span>
            <% end %>
          </td>
          <td>
            <%# Status never relies on color alone: text and shape are each a signal independent of color %>
            <%= status_badge(status.level, status.label) %>
          </td>
          <td>
            <% if status.versions.empty? %>
              —
            <% else %>
              <%= status.versions.join(" / ") %>
              <% if status.drift? %>
                <strong><%= t(".version_drift", count: status.versions.size) %></strong>
              <% end %>
            <% end %>
          </td>
          <td><%= app.cached_app_hosts.size %></td>
          <td>
            <% if status.observed_at %>
              <%= t(".ago", time: time_ago_in_words(status.observed_at)) %>
              <% if status.stale? %>
                <strong><%= t(".stale") %></strong>
              <% end %>
            <% elsif status.level == :unknown %>
              <%= t(".never_collected") %>
            <% else %>
              <%# Some machine in the config has no observation at all — do not give a number that looks precise but
                  does not hold (see Task 11 review, round three). This is information, not an
                  alert, so <strong> is not used — <strong> is reserved for real alerts
                  (the "expired" above), consistent with the way
                  managed_apps/show.html.erb is written, avoiding styling information as an alert (Task 12 review). %>
              <%= t(".partially_collected") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
</div>
