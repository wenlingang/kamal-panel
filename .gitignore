log/
tmp/
.DS_Store
.superpowers/

# Ignore key files for decrypting credentials and more.
/config/*.key

# Ignore SQLite database files.
/storage/*.sqlite3
/storage/*.sqlite3-*
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore uploaded files and Active Storage files in development/test.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep


# Internal design docs — not published.
/docs/superpowers/

# Playwright MCP 的截图与控制台日志
/.playwright-mcp/
