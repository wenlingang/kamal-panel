#!/usr/bin/env ruby
# Reads JSON from stdin: {"value": "<candidate SSH private key text>"} Writes JSON to stdout: {"ok":
# true, "fingerprint": "SHA256:..."}
#                    or {"ok": false, "encrypted": true|false, "error_class": "..."}
#
# This script runs in a separate subprocess; the parent (SshKeyValidator) holds a hard timeout and
# on timeout SIGKILLs this process.
#
# Why we don't read the private key ourselves before calling net-ssh to decide "is it
# passphrase-protected" and skip parsing: we actually did this in one version, and it created a "two
# parsers must agree on the same bytes" double-parser problem. Our homemade OpenSSH header reader
# split on newlines and then ignored lines starting with "-----", while net-ssh internally slices at
# fixed offsets and decodes with the lenient `unpack1("m")` (which ignores non-base64 characters,
# including "-"). For the same malformed input, with "-----" prefixed to every line, the two gave
# different answers: our reader decided "not an OpenSSH private key header, let it through", yet
# net-ssh still decoded cipher=aes256-ctr, kdf=bcrypt as usual, and would really run bcrypt with
# attacker-chosen rounds. Likewise, the iteration count on the PEM/PKCS#8 path is a vulnerability of
# the same shape.
#
# Conclusion: don't try to predict or replicate what the third-party parser will do. This uses the
# same boundary as app/models/kamal/config_parser.rb uses for parsing deploy.yml: hand untrusted
# input to the real parser, run it in a separate subprocess, and have the parent hold a hard
# timeout; whatever the child does and however long it takes, kill it on timeout. Inside the child
# only `rescue StandardError` is used (consistent with bin/parse_deploy_config); there's no need to
# enumerate every exception class net-ssh might raise: anything rescued cleanly emits {"ok": false,
# ...}, and anything not rescued crashes the child with empty stdout; the parent already treats
# "child produced no output" as failure, so neither case turns into an uncaught exception in the
# parent.
#
# No temp files: Kamal::ConfigParser needs them because Kamal::Configuration.create_from requires a
# file path (and must also honor the destination companion-file convention); net-ssh's
# Net::SSH::KeyFactory.load_data_private_key accepts a string directly. A private key is especially
# sensitive material, so it stays off disk whenever possible; here we pass the bytes over
# stdin/stdout, and parent and child create no temp files at all.

require "json"

def emit(hash)
  $stdout.write(JSON.generate(hash))
  $stdout.flush
end

begin
  input = JSON.parse($stdin.read)
  data = input.fetch("value")

  require "net/ssh"
  require "digest"
  require "base64"

  begin
    key = Net::SSH::KeyFactory.load_data_private_key(data, nil, false)
    emit(
      ok: true,
      fingerprint: "SHA256:#{Base64.strict_encode64(Digest::SHA256.digest(key.to_blob)).delete("=")}"
    )
  rescue StandardError, ScriptError => e
    # Same reason as the parent (SshKeyValidator): for malformed/unsupported input net-ssh doesn't
    # guarantee to raise only StandardError subclasses; NotImplementedError inherits from
    # ScriptError. The extra rescue here is not to "prevent a 500" (if the child crashes with empty
    # stdout, the parent already treats that as failure and it doesn't become an uncaught exception
    # in the parent), but so that such failures also go cleanly through emit(ok: false, ...) instead
    # of the child crashing out with an uncaught exception's backtrace.
    #
    # net-ssh itself has to decide "did this parse fail because the key is passphrase-protected" (to
    # decide whether to prompt the user for a passphrase); we reuse its own judgment (KeyFactory's
    # private method classify_key + the corresponding KeyType class's encrypted_key?) rather than
    # guessing separately; again this is to avoid introducing a second source of truth that "must
    # agree with net-ssh".
    encrypted =
      begin
        key_type = Net::SSH::KeyFactory.send(:classify_key, data, "")
        !!key_type.encrypted_key?(data, e)
      rescue StandardError, ScriptError
        false
      end

    emit(ok: false, encrypted: encrypted, error_class: e.class.name)
  end
rescue StandardError, ScriptError => e
  emit(ok: false, encrypted: false, error_class: e.class.name)
end
