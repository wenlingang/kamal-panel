#!/usr/bin/env ruby
# Reads JSON from stdin: {"config_file": "/path/to/deploy.yml", "destination": "production"|null}
# Writes JSON to stdout: {"ok": true, ...} or {"ok": false, "error": "..."}
#
# This script runs in a separate subprocess because Kamal does ERB evaluation and YAML.unsafe_load
# when parsing deploy.yml, both of which are arbitrary-code-execution paths. See spec 7.6.
#
# This script itself neither creates nor deletes any files: config_file (and the companion file in
# the same directory that Kamal looks for by its destination convention, if any) is written to a
# temp directory and cleaned up by the parent process (Kamal::ConfigParser). Reason: this script may
# be SIGKILLed on a parse timeout, and SIGKILL skips every ensure/at_exit; if the cleanup logic
# lived here, a kill would leave the user's pasted deploy.yml content on disk as a temp file. The
# parent is never killed, so cleanup must be owned and carried out by the parent.

require "json"
require "pathname"

def emit(hash)
  $stdout.write(JSON.generate(hash))
  $stdout.flush
end

# In deploy.yml, the brackets in `registry.password: [FOO]` hold an [environment variable name],
# which can be anything. The panel has to write the password into .kamal/secrets-common under that
# name.
#
# [Do not call config.registry.password]: that method resolves the secret, and at parse time
# .kamal/secrets doesn't exist at all, so a perfectly valid deploy.yml would fail to parse. So read
# the raw config instead.
#
# Two cases: array -> take the first item; literal string -> nil (the config already holds
# plaintext, and the panel has no place to inject into).
#
# The third case, no registry section, [cannot happen with Kamal]: even if the whole registry: block
# is omitted, Kamal's own validation reports first `Kamal::ConfigurationError: registry/username: is
# required`, so this method is never reached and the config object above was never successfully
# built. The `return nil if registry.nil?` below is therefore cheap defense at the subprocess
# boundary (in case Kamal relaxes that required-field validation someday), not a tested, supported
# path; don't take it to mean the panel supports apps without a registry section.
def registry_password_env(config)
  raw = config.raw_config
  registry = raw[:registry] || raw["registry"]
  return nil if registry.nil?

  password = registry["password"] || registry[:password]
  password.is_a?(Array) ? password.first.to_s.presence : nil
end

# The registry username, for the panel's own registry probe (RegistryProbe). Only a literal can be
# known at parse time; a secret reference (`username: [ENV]`) is resolved at deploy time, so it
# yields nil, same reasoning as registry_password_env above.
def registry_username(config)
  raw = config.raw_config
  registry = raw[:registry] || raw["registry"]
  return nil if registry.nil?

  username = registry["username"] || registry[:username]
  username.is_a?(String) ? username.presence : nil
end

begin
  input = JSON.parse($stdin.read)

  require "kamal"

  # version must be passed explicitly: otherwise Kamal::Configuration#version falls back to
  # git_version and shells out to git, and the panel's environment has no git repo for the user's
  # app.
  config = Kamal::Configuration.create_from(
    config_file: Pathname.new(input.fetch("config_file")),
    destination: input["destination"],
    version: "unused-by-parsing"
  )

  emit(
    ok: true,
    service: config.service,
    destination: config.destination,
    roles: config.roles.map { |role|
      # proxy: the domains kamal-proxy routes to this role (top-level proxy: merged with the role's
      # own), nil when the role does not run behind the proxy. Only plain strings/booleans cross
      # the JSON boundary; host values are validated by the parent.
      proxy = if role.running_proxy?
        { hosts: Array(role.proxy.hosts).map(&:to_s), ssl: role.proxy.ssl? ? true : false,
          path_prefixes: Array(role.proxy.path_prefixes).map(&:to_s) }
      end
      { name: role.name, hosts: role.hosts, container_prefix: role.container_prefix, proxy: proxy }
    },
    app_hosts: config.app_hosts,
    primary_host: config.primary_host,
    registry_server: config.registry.server,
    # image is the repository path inside the registry ("org/app"); repository prefixes the
    # registry server ("ghcr.io/org/app"). Both are plain strings computed from the config alone.
    image: config.image,
    repository: config.repository,
    # Kamal 2 names an accessory's container after its service_name, which defaults to
    # "<service>-<accessory name>" (no destination suffix) unless the accessory sets service:.
    accessories: config.accessories.map { |accessory|
      { name: accessory.name.to_s, hosts: accessory.hosts, image: accessory.image,
        container_name: accessory.service_name }
    },
    registry_password_env: registry_password_env(config),
    registry_username: registry_username(config),
    # Hand over only the raw string from the ssh: section; never construct objects such as
    # Net::SSH::Proxy::Jump here. This script's output has to cross the JSON boundary back to the
    # parent, and any object would be implicitly #to_s'd into a meaningless string like
    # "#<Net::SSH::Proxy::Jump:0x...>" (Jump defines no meaningful #to_s); the parent would then
    # pass that string as-is to the :proxy option of Net::SSH.start, which blows up at runtime with
    # "NoMethodError: private method 'open' called for an instance of String". Actual object
    # construction and format validation are left to the parent
    # (Kamal::ConfigParser#build_ssh_options) in its own process, where ERB/YAML.unsafe_load aren't
    # involved and it's safe to do.
    ssh_options: {
      user: config.ssh.user,
      port: config.ssh.port,
      proxy: config.ssh.ssh_config["proxy"],
      proxy_command_present: !config.ssh.ssh_config["proxy_command"].nil?
    }
  )
rescue StandardError => e
  emit(ok: false, error: "#{e.class}: #{e.message}")
end
